<Window x:Class="WinCapture.LongShotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCapture 长截图"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Background="{StaticResource PanelBrush}">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
        <StackPanel Width="268">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="长截图" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="CounterText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
            <TextBlock x:Name="HintText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />
            <Border Margin="0,10,0,0" Height="228" Background="#EDF1F0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Image x:Name="PreviewImage" Margin="4" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="LowQuality" />
            </Border>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Content="完成"
                        Click="FinishButton_Click" />
                <Button x:Name="UndoButton" Content="撤销一段" Margin="8,0,0,0" Click="UndoButton_Click" />
                <Button x:Name="CancelButton" Content="取消" Margin="8,0,0,0" Click="CancelButton_Click" />
            </StackPanel>
            <TextBlock Text="Enter 完成 · Esc 取消" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
    </Border>
</Window>
