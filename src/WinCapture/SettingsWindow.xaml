<Window x:Class="WinCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCapture 设置" Width="650" Height="610" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="文件、截图和录屏偏好" Margin="0,4,0,22" Foreground="{StaticResource MutedBrush}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="截图保存目录" VerticalAlignment="Center" />
            <TextBox x:Name="ImageDirectoryTextBox" Grid.Column="1" IsReadOnly="True" />
            <Button Grid.Column="2" Click="BrowseImageButton_Click" Margin="8,0,0,0">浏览</Button>

            <TextBlock Grid.Row="1" Text="录屏保存目录" VerticalAlignment="Center" Margin="0,12,0,0" />
            <TextBox x:Name="VideoDirectoryTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,12,0,0" />
            <Button Grid.Row="1" Grid.Column="2" Click="BrowseVideoButton_Click" Margin="8,12,0,0">浏览</Button>
        </Grid>

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="截图" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="CaptureCursorCheckBox" Content="截图包含鼠标指针" />
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="登录 Windows 后自动启动" />
                <TextBlock Text="延时截图" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <ComboBox x:Name="DelayComboBox" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Tag="0">不延时</ComboBoxItem>
                    <ComboBoxItem Tag="3">3 秒</ComboBoxItem>
                    <ComboBoxItem Tag="5">5 秒</ComboBoxItem>
                    <ComboBoxItem Tag="10">10 秒</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="26,0,0,0">
                <TextBlock Text="录屏默认值" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="RecordSystemAudioCheckBox" Content="录制系统声音" />
                <CheckBox x:Name="RecordMicrophoneCheckBox" Content="录制麦克风" />
                <CheckBox x:Name="RecordCursorCheckBox" Content="显示鼠标指针" />
                <CheckBox x:Name="ShowClicksCheckBox" Content="显示鼠标点击位置" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Margin="0,24,0,14" Padding="14" Background="#EAF2F1" BorderBrush="#C9DDDA" BorderThickness="1" CornerRadius="6">
            <TextBlock Text="配置保存在当前用户的本地应用数据目录。截图和录屏内容不会上传到网络。"
                       Foreground="#365D59" TextWrapping="Wrap" VerticalAlignment="Top" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="CancelButton_Click">取消</Button>
            <Button Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="8,0,0,0">保存设置</Button>
        </StackPanel>
    </Grid>
</Window>
