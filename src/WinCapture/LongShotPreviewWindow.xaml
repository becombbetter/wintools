<Window x:Class="WinCapture.LongShotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCapture 长截图预览" Width="1040" Height="820" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：缩放控制 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="ZoomOutButton" Content="−" Padding="11,5" Margin="10,0,0,0"
                            ToolTip="缩小（Ctrl + -）" Click="ZoomOutButton_Click" />
                    <TextBlock x:Name="ZoomText" Text="100%" Width="62" Margin="6,0,0,0" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Content="+" Padding="11,5"
                            ToolTip="放大（Ctrl + +）" Click="ZoomInButton_Click" />
                    <Border Width="1" Background="{StaticResource LineBrush}" Margin="12,3" />
                    <Button Content="适应宽度" Margin="0" ToolTip="让整张长图横向铺满窗口（Ctrl + 0）"
                            Click="ZoomFitWidthButton_Click" />
                    <Button Content="50%" Margin="6,0,0,0" Click="ZoomPresetButton_Click" Tag="0.5" />
                    <Button Content="100%" Margin="6,0,0,0" ToolTip="原始大小（Ctrl + 1）"
                            Click="ZoomPresetButton_Click" Tag="1" />
                    <Button Content="200%" Margin="6,0,0,0" Click="ZoomPresetButton_Click" Tag="2" />
                </StackPanel>
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>

        <!-- 中间：可滚动预览。背景铺深灰，方便看清长图边界 -->
        <Border Grid.Row="1" Background="#BBC2C0">
            <ScrollViewer x:Name="PreviewScroll" Margin="12" Background="#E7EBEA"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="PreviewScroll_PreviewMouseWheel">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="PreviewImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="Fant"
                           MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                           MouseMove="PreviewImage_MouseMove"
                           MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部：动作条 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="OcrButton_Click">OCR 识别</Button>
                    <Button Click="PinButton_Click" Margin="6,0,0,0">置顶贴图</Button>
                    <Button Click="CopyButton_Click" Margin="6,0,0,0">复制</Button>
                    <Button Click="EditButton_Click" Margin="6,0,0,0">编辑标注</Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Margin="6,0,0,0">保存</Button>
                    <Button Click="CloseButton_Click" Margin="6,0,0,0">关闭</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
