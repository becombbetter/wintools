<Window x:Class="WinCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCapture" Width="980" Height="660" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="126" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172127" Padding="26,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="WinCapture" Foreground="White" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="截图、长截图与录屏" Foreground="#AEC0C4" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="FullCaptureButton_Click" ToolTip="截取全部显示器" Foreground="White" Background="#253238" BorderBrush="#425258">▣ 全屏</Button>
                    <Button Click="ManualButton_Click" ToolTip="使用手册" Foreground="White" Background="#253238" BorderBrush="#425258" Margin="8,0,0,0">? 手册</Button>
                    <Button Click="SettingsButton_Click" ToolTip="设置" Foreground="White" Background="#253238" BorderBrush="#425258" Margin="8,0,0,0">⚙ 设置</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,24,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ActionButton}" Click="RegionCaptureButton_Click">
                <StackPanel>
                    <TextBlock Text="⌗" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="区域截图" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,3" />
                    <TextBlock Text="PrintScreen" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="WindowCaptureButton_Click" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="▣" FontSize="27" Foreground="#D88B1F" />
                    <TextBlock Text="窗口截图" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,3" />
                    <TextBlock Text="Alt + PrintScreen" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="LongCaptureButton_Click" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="⇣" FontSize="29" Foreground="#3C7BBE" />
                    <TextBlock Text="长截图" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,3" />
                    <TextBlock Text="Ctrl + PrintScreen" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource ActionButton}" Click="RecordButton_Click" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="●" FontSize="25" Foreground="{StaticResource SignalBrush}" />
                    <TextBlock Text="录屏" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,3" />
                    <TextBlock Text="Ctrl + Shift + R" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="最近文件" FontSize="16" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right" Padding="9,4" Click="OpenImageFolderButton_Click">打开保存目录</Button>
            </DockPanel>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                <ListView x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                          MouseDoubleClick="HistoryList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Kind}" Width="72" />
                            <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding FileName}" Width="560" />
                            <GridViewColumn Header="时间" DisplayMemberBinding="{Binding DisplayTime}" Width="130" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{StaticResource MutedBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="Windows 11 · x64" Foreground="#879298" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
