<Window x:Class="WinCapture.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 识别结果" Width="620" Height="420" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="识别结果" FontSize="16" FontWeight="SemiBold" />
        <TextBox x:Name="ResultTextBox" Grid.Row="1" Margin="0,12" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="CopyButton_Click">复制文字</Button>
            <Button Style="{StaticResource PrimaryButton}" Click="CloseButton_Click" Margin="8,0,0,0">完成</Button>
        </StackPanel>
    </Grid>
</Window>
